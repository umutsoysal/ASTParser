{
  "name": "ASTParser (Go + tree-sitter)",
  "image": "mcr.microsoft.com/devcontainers/go:1.24-bookworm",

  // The tree-sitter bindings are cgo, so gopls has to compile C to resolve the
  // imports. On a Windows host there is no gcc, which is why VS Code reports
  // errors on packages that build fine in CI. Running the editor's Go tooling
  // inside this Linux container makes the editor agree with the build.
  "postCreateCommand": "go mod download",

  "customizations": {
    "vscode": {
      "extensions": ["golang.go"],
      "settings": {
        "go.useLanguageServer": true,
        "go.toolsManagement.autoUpdate": true,
        "gopls": {
          "build.env": {
            "CGO_ENABLED": "1"
          }
        }
      }
    }
  }
}
